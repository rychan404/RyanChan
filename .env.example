# Web3Forms access key for the contact form. Not yet issued (spec section 16, item 1).
# Until this is set, the contact form fails into its error state rather than
# silently reporting success.
VITE_WEB3FORMS_KEY=

# Absolute origin of the deployed site, e.g. https://example.com — no trailing
# slash. Build-time only: it makes og:url / og:image absolute, which every link
# preview bot requires. Without it the build still succeeds, prints a warning,
# and emits relative og:url with no og:image.
VITE_SITE_URL=
